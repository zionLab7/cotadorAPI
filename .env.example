PORT=3000
HEADLESS=true
PAINEL_USER=seu_email@exemplo.com.br
PAINEL_PASSWORD=sua_senha_aqui
PAINEL_URL=https://beta.paineldocorretor.com.br

# Token de Segurança da sua API (Bearer / x-api-key / ?token=)
# Protege seus endpoints contra acessos não autorizados
API_SECRET_TOKEN=seu_token_secreto_super_seguro_aqui

# Servidor MCP para ChatGPT: OAuth com JWT assinado (RS256 ou ES256).
# Configure um provedor OAuth que emita access tokens com aud=MCP_PUBLIC_URL,
# scope=cotador:use, email e email_verified=true. O provedor precisa oferecer
# authorization code + PKCE S256 e metadados de descoberta OAuth/OIDC.
MCP_PUBLIC_URL=https://seu-dominio-real/mcp
MCP_OAUTH_ISSUER=https://seu-provedor-oauth
MCP_OAUTH_JWKS_URI=https://seu-provedor-oauth/.well-known/jwks.json
MCP_ALLOWED_EMAILS=usuario1@example.com,usuario2@example.com
